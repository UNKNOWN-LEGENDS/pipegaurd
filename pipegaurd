class Rule:
    def __init__(self, rule_id, severity, category, title, pattern, flags=0):
        self.id = rule_id
        self.severity = severity
        self.category = category
        self.title = title
        self.regex = re.compile(pattern, flags) if pattern else None


# Start of a command: beginning of line or after whitespace / ; & | ( ` { !
B = r"(?:^|(?<=[\s;&|(`{!]))"


def cmd(pattern):
    """Match `pattern` only where a new command/word starts."""
    return B + "(?:" + pattern + ")"



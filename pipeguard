# Findings that come from analysis logic rather than a single regex.
META_RULES = {r.id: r for r in [
    Rule("OBF005", "low", "obfuscation", "Very long line (can hide code off-screen)", None),
    Rule("OBF006", "high", "obfuscation", "Hidden text encoded in base64", None),
    Rule("TRN010", "high", "transport", "Script was fetched over unencrypted HTTP", None),
    Rule("TRN011", "high", "transport", "HTTPS request was redirected to plain HTTP", None),
    Rule("TRN012", "low", "transport", "Request was redirected to a different host", None),
]}

# Lines that only print a message. For these, low/medium rules ignore text
# inside quotes, so `echo "please run with sudo"` isn't flagged.
# High/critical rules always see the full line.
MESSAGE_CMD = re.compile(
    r"^\s*(?:echo|printf|say|info|warn|warning|err|error|log|msg|note|abort|die|fatal|ohai|puts)\b")

B64_BLOB = re.compile(r"[A-Za-z0-9+/]{40,}={0,2}")
URL_RE = re.compile(r"https?://[^\s\"'<>`;|)$\\]+")  # stops at ${VARS} too


# --------------------------------------------------------------------------
# Text helpers
# --------------------------------------------------------------------------

def logical_lines(text):
    """Yield (first_line_number, line), joining backslash-continued lines."""
    buf, start = [], None
    for number, raw in enumerate(text.splitlines(), 1):
        if start is None:
            start = number
        stripped = raw.rstrip()
        trailing = len(stripped) - len(stripped.rstrip("\\"))
        if trailing % 2 == 1:          # odd count of "\" = line continues
            buf.append(stripped[:-1])
            continue
        buf.append(raw)
        yield start, " ".join(buf)
        buf, start = [], None
    if buf:
        yield start, " ".join(buf)


def strip_comment(line):
    """Remove a trailing shell comment, respecting quotes and escapes."""
    in_single = in_double = escaped = False
    prev = " "
    for i, ch in enumerate(line):
        if escaped:
            escaped = False
        elif ch == "\\" and not in_single:
            escaped = True
        elif ch == "'" and not in_double:
            in_single = not in_single
        elif ch == '"' and not in_single:
            in_double = not in_double
        elif ch == "#" and not in_single and not in_double and (prev.isspace() or prev in ";&|("):
            return line[:i]
        prev = ch
    return line


def mask_quotes(line):
    """Drop the contents of quoted strings: echo "use sudo" -> echo "" """
    out = []
    in_single = in_double = escaped = False
    for ch in line:
        inside = in_single or in_double
        if escaped:
            escaped = False
            if not inside:
                out.append(ch)
            continue
        if ch == "\\" and not in_single:
            escaped = True
            if not inside:
                out.append(ch)
            continue
        if ch == "'" and not in_double:
            in_single = not in_single
            out.append(ch)
        elif ch == '"' and not in_single:
            in_double = not in_double
            out.append(ch)
        elif not inside:
            out.append(ch)
    return "".join(out)


def try_decode_base64(blob):
    """Return decoded text if `blob` is base64 hiding readable text, else None."""
    core = blob.rstrip("=")
    if len(core) < 40:
        return None
    padded = core + "=" * (-len(core) % 4)
    try:
        data = base64.b64decode(padded, validate=True)
        text = data.decode("utf-8")
    except (binascii.Error, ValueError, UnicodeDecodeError):
        return None
    if not text:
        return None
    printable = sum(1 for c in text if c.isprintable() or c in "\n\r\t")
    if printable / len(text) < 0.95 or not re.search(r"\s", text):
        return None     # binary junk or a single token: not hidden commands
    return text


def snippet(line, limit=110):
    line = " ".join(line.split())
    return line if len(line) <= limit else line[:limit - 3] + "..."


# --------------------------------------------------------------------------
# Scanner
# --------------------------------------------------------------------------

class Scanner:
    def __init__(self):
        self.findings = []
        self.urls = []

    def add(self, rule, line, code, context=None):
        self.findings.append({
            "rule": rule.id,
            "severity": rule.severity,
            "category": rule.category,
            "title": rule.title,
            "line": line,
            "code": snippet(code),
            "context": context,
        })

    def scan(self, text, depth=0, outer_line=None):
        for number, raw in logical_lines(text):
            line_no = outer_line or number
            context = "decoded from base64 on line %d" % outer_line if outer_line else None
            code = strip_comment(raw)
            if not code.strip():
                continue

            for url in URL_RE.findall(code):
                if url not in self.urls:
                    self.urls.append(url.rstrip(".,"))

            masked = mask_quotes(code) if MESSAGE_CMD.match(code) else code
            for rule in RULES:
                target = code if rule.severity in ("high", "critical") else masked
                if rule.regex.search(target):
                    self.add(rule, line_no, raw, context)

            if len(code) > LONG_LINE:
                self.add(META_RULES["OBF005"], line_no, raw[:80], context)

            if depth < MAX_DECODE_DEPTH:
                for match in B64_BLOB.finditer(code):
                    decoded = try_decode_base64(match.group(0))
                    if decoded:
                        self.add(META_RULES["OBF006"], line_no,
                                 "decodes to: " + decoded, context)
                        self.scan(decoded, depth + 1, line_no)
        return self


def compute_score(findings):
    """Each rule counts once, so 40x `sudo` doesn't outweigh one reverse shell."""
    per_rule = {f["rule"]: f["severity"] for f in findings}
    return min(sum(SEVERITY_WEIGHT[s] for s in per_rule.values()), 100)


def compute_verdict(findings, score):
    if not findings:
        return "clean"
    if score < 10:
        band = "low"
    elif score < 30:
        band = "medium"
    elif score < 60:
        band = "high"
    else:
        band = "critical"
    worst = max(findings, key=lambda f: SEVERITIES.index(f["severity"]))["severity"]
    return max(band, worst, key=SEVERITIES.index)



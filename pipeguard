class PipeguardError(Exception):
    pass


def fetch_url(url, max_size, timeout):
    # Pretend to be curl: some servers send different content to browsers,
    # and we want to see what `curl | bash` would have received.
    request = urllib.request.Request(url, headers={"User-Agent": "curl/8.5.0", "Accept": "*/*"})
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            data = response.read(max_size + 1)
            final_url = response.geturl()
            content_type = response.headers.get("Content-Type", "")
    except urllib.error.HTTPError as exc:
        raise PipeguardError("server returned HTTP %d for %s" % (exc.code, url))
    except urllib.error.URLError as exc:
        raise PipeguardError("could not download %s: %s" % (url, exc.reason))
    except (TimeoutError, OSError) as exc:
        raise PipeguardError("could not download %s: %s" % (url, exc))
    if len(data) > max_size:
        raise PipeguardError("script is larger than %s; refusing (use --max-size)" % human_size(max_size))
    return data, final_url, content_type


def read_file(path, max_size):
    try:
        with open(path, "rb") as handle:
            data = handle.read(max_size + 1)
    except OSError as exc:
        raise PipeguardError("cannot read %s: %s" % (path, exc.strerror or exc))
    if len(data) > max_size:
        raise PipeguardError("file is larger than %s; refusing (use --max-size)" % human_size(max_size))
    return data


def load_input(target, max_size, timeout):
    meta = {"source": target, "final_url": None, "content_type": None}
    if target is None:
        if sys.stdin.isatty():
            raise PipeguardError("no script given. Try: pipeguard URL, pipeguard FILE, or curl URL | pipeguard")
        meta["source"] = "<stdin>"
        data = sys.stdin.buffer.read(max_size + 1)
        if len(data) > max_size:
            raise PipeguardError("input is larger than %s; refusing (use --max-size)" % human_size(max_size))
    elif re.match(r"^https?://", target, re.IGNORECASE):
        data, meta["final_url"], meta["content_type"] = fetch_url(target, max_size, timeout)
    elif "://" in target:
        raise PipeguardError("only http:// and https:// URLs are supported")
    else:
        data = read_file(target, max_size)
    if not data.strip():
        raise PipeguardError("the script is empty")
    return data, meta


def transport_findings(scanner, meta):
    source, final = meta["source"] or "", meta["final_url"]
    if source.lower().startswith("http://"):
        scanner.add(META_RULES["TRN010"], 0, source)
    if final and final != source:
        if source.lower().startswith("https://") and final.lower().startswith("http://"):
            scanner.add(META_RULES["TRN011"], 0, "%s -> %s" % (source, final))
        if urllib.parse.urlparse(source).hostname != urllib.parse.urlparse(final).hostname:
            scanner.add(META_RULES["TRN012"], 0, "%s -> %s" % (source, final))


def notices_for(data, text, meta):
    notes = []
    if b"\x00" in data:
        notes.append("Input contains NUL bytes - it looks binary, so this analysis is unreliable.")
    if meta.get("content_type") and "html" in meta["content_type"].lower():
        notes.append("Server returned HTML, not a script. Is the URL right? (GitHub 'blob' links need 'raw')")
    first = text.lstrip().splitlines()[0] if text.strip() else ""
    if first.startswith("#!") and not re.search(r"\b(?:ba|da|z|k)?sh\b", first):
        notes.append("Shebang is '%s' - rules are tuned for shell scripts." % first.strip())
    return notes


